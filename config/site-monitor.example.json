{
  "schedule": {
    "cron": "0 13 * * *",
    "timezone": "UTC"
  },
  "delivery": {
    "artifactReport": true,
    "email": {
      "enabled": false,
      "from": "",
      "to": [],
      "subject": "Morning site monitoring report"
    }
  },
  "defaults": {
    "userAgent": "CarolBalesSiteMonitor/1.0 (+https://github.com/CarolBales/carolbales.github.io)",
    "timeoutMs": 15000,
    "maxRetries": 2,
    "retryDelayMs": 1000,
    "maxItems": 20
  },
  "phrases": [
    "standing work table",
    "sewing table",
    "cutting table",
    "craft table",
    "adjustable height work table",
    "adjustable height table",
    "vintage sewing patterns",
    "sewing patterns"
  ],
  "sites": [
    {
      "name": "Craigslist Atlanta",
      "type": "html",
      "url": "https://www.craigslist.org/search/area/atlanta?cat=sse#search=2",
      "allowed": false,
      "notes": "Review Craigslist terms of use and robots guidance before enabling automated collection."
    },
    {
      "name": "EstateSales.net Atlanta 30307",
      "type": "html",
      "url": "https://www.estatesales.net/GA/Atlanta/30307",
      "allowed": false,
      "notes": "Review EstateSales.net terms, robots guidance, and rate limits before enabling automated collection."
    },
    {
      "name": "Facebook Marketplace Atlanta",
      "type": "html",
      "url": "https://www.facebook.com/marketplace/atlanta/",
      "allowed": false,
      "notes": "Facebook Marketplace typically requires login and has restrictive automation rules; use only if explicitly permitted."
    }
  ]
}
